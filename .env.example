# Gemini API key — scores the startup idea (onboarding + /tools/startup-idea-rater).
# NOTE: VITE_ vars are inlined into the client bundle and are publicly readable.
VITE_GEMINI_API_KEY=

# Local `npm run dev` — Vite serves `/api/ingest-game-day` and writes to Mongo using this URI.
MONGODB_URI=
# Optional database name (default: startup-game)
# MONGODB_DB_NAME=startup-game

# Optional: lock down the ingest route (server + client must use the same value)
# ANALYTICS_INGEST_SECRET=
# VITE_ANALYTICS_INGEST_SECRET=

# Optional: custom API URL (default /api/ingest-game-day)
# VITE_ANALYTICS_API_URL=

# Optional: dev-only — set true to skip Mongo POST (keep local /admin SQLite only)
# VITE_DISABLE_REMOTE_ANALYTICS=true
