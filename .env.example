# Groq API key(s) — scores the startup idea and generates its roadmap
# (onboarding + /tools/startup-idea-rater). Get free keys at console.groq.com.
# Server-only: read by /api/rate-idea and never reaches the browser.
# Do NOT add a VITE_ prefix — that would inline it into the public client bundle.
# Format: a bracketed, comma-separated list — one key is fine, more keys let
# the server rotate to the next one if a key hits its free-tier daily quota.
# GROQ_API_KEYS=[gsk_xxxxxxxx]
GROQ_API_KEYS=

# Optional: email alert when every GROQ_API_KEYS entry fails on the same
# request (quota exhausted, all keys down, etc). Needs a free Resend API key
# (resend.com) — no domain verification required, uses their sandbox sender.
# At most one email per 6h even if the outage continues.
# RESEND_API_KEY=
# ALERT_EMAIL=

# Optional: the canonical public origin, used for canonical URLs, OG tags, the
# sitemap and share links. Defaults to https://failunicorn.vercel.app
# VITE_SITE_URL=

# Local `npm run dev` — Vite serves `/api/ingest-game-day` and writes to Mongo using this URI.
MONGODB_URI=
# Optional database name (default: startup-game)
# MONGODB_DB_NAME=startup-game

# Optional: lock down the ingest route (server + client must use the same value)
# ANALYTICS_INGEST_SECRET=
# VITE_ANALYTICS_INGEST_SECRET=

# Optional: custom API URL (default /api/ingest-game-day)
# VITE_ANALYTICS_API_URL=

# Optional: dev-only — set true to skip Mongo POST (keep local /admin SQLite only)
# VITE_DISABLE_REMOTE_ANALYTICS=true

# Admin dashboard (/admin) — protects the read-only analytics view.
# Required for /admin to work at all.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Bearer token issued to the browser after a successful login. Any random string.
ADMIN_SECRET=
