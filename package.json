    "three": "^0.183.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.63.0",
